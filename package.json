{
  "name": "dsh-liquid-glass-skin",
  "version": "0.8.0",
  "description": "Liquid Glass theme and nested conversation folders for DSH Desktop Beta",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview-server.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-ui.mjs",
    "test:installed": "node scripts/check-installed-runtime.mjs && node scripts/check-client-runtime.mjs",
    "pack:plugin": "npm run build && npm pack --pack-destination releases"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "author": "anjon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biek12/dsh-liquid-glass-skin.git"
  },
  "homepage": "https://github.com/biek12/dsh-liquid-glass-skin#readme",
  "bugs": {
    "url": "https://github.com/biek12/dsh-liquid-glass-skin/issues"
  }
}
